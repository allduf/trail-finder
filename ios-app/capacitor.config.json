{
  "appId": "com.allduf.trailfinder",
  "appName": "Trail Finder",
  "webDir": "www",
  "backgroundColor": "#f2efe7",
  "server": {
    "url": "https://allduf.github.io/trail-finder/",
    "errorPath": "offline.html"
  },
  "ios": {
    "limitsNavigationsToAppBoundDomains": true,
    "contentInset": "never",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#f2efe7",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
