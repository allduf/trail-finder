    { "s": "grs", "n": ["Lemon Squeezy"], "kind": "Green skills zone", "level": "green", "text": "A beginner learning area with a small pump track, rocks and wooden features to build confidence before the park's trails." },
    { "s": "grs", "n": ["Tim's Trim"], "kind": "Green flow trail", "level": "green", "km": 3.5, "text": "Machine-built beginner flow trail with wide sweeping turns, small rollers, berms and wooden bridges; the next step after Lemon Squeezy. Named after Tim Peck, who worked at Grouse for 39 years." },
    { "s": "grs", "n": ["Oh Deer!"], "kind": "Blue flow trail", "level": "blue", "km": 1.8, "text": "Machine-built intermediate flow trail after Tim's Trim: gentle berms and rollers, with rock drops, wood drops and bridges, through forest and open meadows." },
    { "s": "grs", "n": ["Sooty's Jump Line"], "kind": "Jump line", "km": 1.2, "text": "The park's main jump trail, aimed at intermediates but fun for experts: tabletops and tombstone-shaped jumps, tight berms and big fast berms." },
