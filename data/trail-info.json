  "trails": [
    { "s": "fer", "n": ["Silk", "Manchuria"], "no": "1/2", "kind": "Multi-use", "text": "Double-track road; part of the multi-use network." },
    { "s": "fer", "n": ["Boom Trail", "Boom"], "no": "3", "kind": "Multi-use", "text": "Wide fire road with gentle grades through cedar forest and good views. Made for riders who are new to riding off pavement." },
    { "s": "fer", "n": ["Cedar Trail"], "no": "4", "kind": "Multi-use", "text": "Gravel road back to the base, much like Boom Trail." },
    { "s": "fer", "n": ["View Trail"], "no": "5", "kind": "Multi-use", "text": "Fire road used to get to the Provincial Park." },
    { "s": "fer", "n": ["Deer Trail"], "no": "6", "kind": "Freeride / flow", "text": "Starts as a wide gravel fire road and turns into wide trail with small berms, rollers and gentle grades through the trees." },
    { "s": "fer", "n": ["Will Power"], "no": "7", "kind": "Technical", "text": "One of Fernie's first downhill trails: fast, fall-line and technical through the forest. Racers love it." },
    { "s": "fer", "n": ["Trac III"], "no": "8", "kind": "Technical", "text": "Like Will Power, with more rock and loose soil." },
    { "s": "fer", "n": ["Playground"], "no": "9", "kind": "Technical", "text": "Technical corners, several line choices and a few drops and jumps." },
    { "s": "fer", "n": ["Case Closed"], "no": "9A", "kind": "Technical", "text": "Steep pitches into supported corners, with off-camber roots." },
    { "s": "fer", "n": ["Duff Dynasty"], "no": "10", "kind": "Freeride / flow", "text": "Gentle and smooth, with twists, rollers and bridges through cedar forest. Good for families and kids." },
    { "s": "fer", "n": ["Kodiak Karnage"], "no": "11", "kind": "Technical", "text": "Fast, steep and loose. Committing; experts only." },
    { "s": "fer", "n": ["Gorby", "Gorbie Loop"], "no": "12", "kind": "Multi-use", "text": "Fire road through Cedar Bowl to the Provincial Park. Expect long climbs to get back to the base." },
    { "s": "fer", "n": ["GT Racer"], "no": "13", "kind": "Freeride / flow", "text": "Hand-built, winding trail through cedar forest beside Mr. Berms. Good for green riders practising berms and carrying speed." },
    { "s": "fer", "n": ["Aggravated Assault", "Aggravated Assault Extension"], "no": "14", "kind": "Technical", "text": "Singletrack with some wooden features; a harder version of Hollow Tree." },
    { "s": "fer", "n": ["Double Creek", "Double Creek Extension"], "no": "15/15A", "kind": "Multi-use", "text": "Cross-country trail across the lower mountain through shady forest, with bridges over creeks." },
    { "s": "fer", "n": ["Ben's Big Rig"], "no": "17", "kind": "Freeride / flow", "text": "Small berms and easy traverses up top. Halfway down you can go to Deer Trail, or carry on to the lower part with bigger berms, which leads to Honey Bee and Eville." },
    { "s": "fer", "n": ["Yellowjacket"], "no": "18", "kind": "Freeride / flow", "text": "New in 2026: a blue jump trail for progressing, through shady forest and over a creek, ending at Holo Bike and Eville." },
    { "s": "fer", "n": ["Rubber Ducky"], "no": "19", "kind": "Freeride / flow", "text": "Black flow trail with big berms and advanced features. You need to be able to jump." },
    { "s": "fer", "n": ["Monorail"], "no": "20", "kind": "Freeride / flow", "text": "Short, playful jump trail into the base." },
    { "s": "fer", "n": ["Phat Larry's"], "no": "21", "kind": "Technical", "text": "Classic steep singletrack down a cedar ravine, with steeps and drops and a flowy finish." },
    { "s": "fer", "n": ["Hollow Tree"], "no": "22", "kind": "Technical", "text": "Medium difficulty, with natural roots, rocks and rollers." },
    { "s": "fer", "n": ["Holo Bike"], "no": "23", "kind": "Technical", "text": "Next to Phat Larry's, but with easier grades." },
    { "s": "fer", "n": ["Alternate Flight Pattern"], "no": "24", "kind": "Technical", "text": "Home to the resort's biggest built wooden features." },
    { "s": "fer", "n": ["Lil' Miss Buffit", "Lil'Miss Buffit"], "no": "26", "kind": "Technical", "text": "Singletrack side route running alongside Cedar Trail." },
    { "s": "fer", "n": ["Bicycle Thief", "Bike Thief"], "no": "27", "kind": "Technical", "text": "Technical corners, off-camber roots and rocky sections, with valley views halfway down. A short top section (from Trespass Trail to Diamond Back) is double black for its must-do drops and rooty corners; the rest is black." },
    { "s": "fer", "n": ["Neverland"], "no": "28", "kind": "Technical", "text": "Technical but flowy descent with plenty of natural features." },
    { "s": "fer", "n": ["Rumplestumpskin", "Upper Rumplestumpskin", "Lower Rumplestumpskin"], "no": "29A/29B", "kind": "Technical (upper), freeride / flow (lower)", "text": "Old-school downhill trail with rock rolls, tight corners and forest sections. Below Rock Landing the lower part adds technical features and jumps." },
    { "s": "fer", "n": ["Leave Me A Loam"], "no": "29C", "kind": "Technical", "text": "Fresh hand-built line in the forest, reached from Lower Rumplestumpskin." },
    { "s": "fer", "n": ["Megasaurus"], "no": "30", "kind": "Multi-use", "text": "Fire road across the mountain's bowls with big views and a lot of pedalling. Rated black." },
    { "s": "fer", "n": ["BC Cup"], "no": "31", "kind": "Technical", "text": "Drops in from Diamond Back corner and takes a fast, direct line through steep old-growth cedars." },
    { "s": "fer", "n": ["Top Gun"], "no": "32", "kind": "Freeride / flow", "text": "A favourite: fast, flowy berms and jumps. Every feature can be rolled, so it suits mixed-ability groups or riders stepping up." },
    { "s": "fer", "n": ["Top Gun Extension", "Top Gun Ext."], "no": "32A", "kind": "Freeride / flow", "text": "Machine-built, fast way to get to Top Gun." },
    { "s": "fer", "n": ["Mr. Berms", "Mr Berms"], "no": "33", "kind": "Freeride / flow", "text": "Warm-up trail across a ski run with berms and rollers. A good first blue trail." },
    { "s": "fer", "n": ["Bin Logdin"], "no": "34", "kind": "Freeride / flow", "text": "Like Eville but bigger: fast, flowy berms and jumps." },
    { "s": "fer", "n": ["Eville", "Eville Strikes Back"], "no": "35", "kind": "Freeride / flow", "text": "Green flow trail through open forest back to the Holo Bike connector, with small jumps and berms to build confidence." },
    { "s": "fer", "n": ["Ewok"], "no": "36", "kind": "Technical", "text": "Tight trail through the forest with low ladders and bridges that test balance." },
    { "s": "fer", "n": ["TNT Upper", "TNT"], "no": "37A", "kind": "Technical", "text": "Technically demanding trail through shady forest, with some natural drops and roots." },
    { "s": "fer", "n": ["Communication Breakdown", "TNT Lower"], "no": "37B", "kind": "Freeride / flow", "text": "A rebuild of the lowest part of TNT: machine-built jumps and rollers for progressing on flow and jump trails." },
    { "s": "fer", "n": ["Rockstar"], "no": "37C", "kind": "Freeride / flow", "text": "Short technical section that ends on a long wooden ramp down to the parking lot." },
    { "s": "fer", "n": ["Cats Pyjamas"], "no": "38", "kind": "Technical", "text": "On the Kodiak run and as steep and technical as Kodiak Karnage: long steep, rooty chutes." },
    { "s": "fer", "n": ["Lizard Lane"], "no": "39", "kind": "Freeride / flow", "text": "Flowy jump trail through big cedars near the base. Good for ending the day and working on jumps and berms." },
    { "s": "cgp", "n": ["Mr. Green"], "level": "Beginner", "kind": "Smooth, machine-built", "text": "Mellow, obstacle-free beginner trail with small berms, for learning to corner and getting used to gravity riding." },
    { "s": "cgp", "n": ["Dirt Wave"], "level": "Intermediate", "kind": "Flow", "text": "A downhill pump track: machine-built berms, rollers and table tops, rideable fast or slow, and good for learning to get air." },
    { "s": "cgp", "n": ["Lower Dirt Wave"], "level": "Intermediate", "kind": "Flow", "text": "Carries on from Dirt Wave: pump the rollers to keep your speed." },
    { "s": "cgp", "n": ["Hot Lap"], "level": "Intermediate", "kind": "Flow", "text": "High-speed flow trail with table tops and mogul-like rollers." },
    { "s": "cgp", "n": ["Auto Pilot"], "level": "Intermediate/Advanced", "kind": "Jump", "text": "Intermediate jumps: a place to learn to jump or go bigger." },
    { "s": "cgp", "n": ["Doggers"], "level": "Intermediate/Advanced", "kind": "Flow", "text": "Park favourite with rollers, gaps and berms all the way down, plus options for bigger features." },
    { "s": "cgp", "n": ["Hand Job"], "level": "Intermediate/Advanced", "kind": "Technical", "text": "Hand-built downhill track: a fast chute in, then a rough, rocky descent with loam and roots." },
    { "s": "cgp", "n": ["Red Dragon", "Red-Dragon"], "level": "Intermediate/Advanced", "kind": "Flow", "text": "Steeper, faster flow trail with tight berms top to bottom." },
    { "s": "cgp", "n": ["Zig Zag"], "level": "Intermediate/Advanced", "kind": "Technical", "text": "The park's classic loam trail: several hand-built lines through natural features." },
    { "s": "cgp", "n": ["Pay Dirt"], "level": "Advanced", "kind": "Flow", "text": "A faster, bigger Hot Lap on sandy dirt, with natural doubles and rollers." },
    { "s": "cgp", "n": ["Dynamite Panther", "Dynamite Panther Access"], "level": "Advanced", "kind": "Tech-flow", "text": "Steep, fast loam trail with optional doubles, step-downs and a rock roll." },
    { "s": "cgp", "n": ["Devil's Elbow"], "level": "Advanced", "kind": "Tech-flow", "text": "Hand-built, rooty singletrack with moderate drops and doubles." },
    { "s": "cgp", "n": ["Lift Off"], "level": "Advanced", "kind": "Jump", "text": "Advanced jump trail with rollable table tops, gaps and optional side hits." },
    { "s": "cgp", "n": ["Cruise Control"], "level": "Advanced", "kind": "Jump", "text": "Relaxed jump trail that starts with a drop and ramp, then small gaps and steep berms: a step up for jumps and drops." },
    { "s": "cgp", "n": ["Sliver"], "level": "Expert", "kind": "Tech-flow", "text": "Starts with a wooden drop, optional doubles all the way, and a wooden gap at the end. Drops and gaps are mandatory." },
    { "s": "cgp", "n": ["Flight Deck"], "level": "Pro line", "kind": "Jump", "text": "Very fast, very big gap jumps (40 to 50 ft). Every feature is mandatory." },
    { "s": "cgp", "n": ["Coastal Cruise"], "level": "Pro line", "kind": "Jump", "text": "Jump trail with large gaps, built by the Coastal Crew. Every feature is mandatory." },
