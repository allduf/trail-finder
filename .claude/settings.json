{
  "permissions": {
    "allow": [
      "Bash(node scripts/wording-check.mjs)",
      "Bash(node scripts/stamp.mjs --check)",
      "Bash(node scripts/i18n/build.mjs)",
      "Bash(node scripts/phone-test.mjs)",
      "Bash(BROWSER=chromium node scripts/phone-test.mjs)",
      "Bash(bash scripts/site-data.sh get)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)"
    ],
    "ask": [
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(terms.html)",
      "Edit(privacy.html)",
      "Edit(ios-app/**)",
      "Write(ios-app/**)",
      "Edit(android-app/**)",
      "Write(android-app/**)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.p8)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
