{
  "appId": "com.allduf.trailfinder",
  "appName": "Trail Finder",
  "webDir": "www",
  "backgroundColor": "#f2efe7",
  "server": {
    "url": "https://trailfinderapp.ca/",
    "errorPath": "offline.html",
    "allowNavigation": [
      "trailfinderapp.ca",
      "www.trailfinderapp.ca"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#f2efe7",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "LIGHT"
    }
  }
}
